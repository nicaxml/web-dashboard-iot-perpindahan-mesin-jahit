<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Perpindahan Mesin</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Arial", sans-serif;
    }

    body {
      background-color: #f9cf96;
      display: flex;
      min-height: 100vh;
      color: #000;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
      background-color: #fff2cc;
      width: 180px;
      padding: 20px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border-radius: 0 20px 20px 0;
      position: sticky;
      top: 0;
      height: 100vh; /* full tinggi viewport */
    }

    /* Sapaan di atas sidebar */
    .sidebar .greeting {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 25px; /* jarak lebih jelas */
      text-align: center;
    }

    .sidebar a {
      display: block;
      width: 85%;
      margin: 10px 0;
      padding: 8px 12px;
      text-align: center;
      text-decoration: none;
      color: #000;
      font-size: 16px;
      font-weight: 600;
      background-color: #c9d3ff;
      border-radius: 12px;
      box-shadow: 0 0 3px rgba(0,0,0,0.1);
      transition: all 0.3s;
      position: relative;
    }

    .sidebar a:hover {
      background-color: #aabaff;
      transform: scale(1.05);
    }

    .sidebar a.logout {
      background-color: #baff4d;
    }
    .sidebar a.logout:hover {
      background-color: #a3ff1f;
    }

    .sidebar a.active {
      border-left: 4px solid #3b3bff;
      background-color: #aabaff;
      transform: scale(1.05);
    }

    /* ===== MAIN CONTENT ===== */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      text-align: center;
    }

    /* ===== HEADER STICKY ===== */
    .header {
      background-color: #f9cf96;
      width: 100%;
      padding: 20px 0;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .header h1 {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .header h2 {
      font-size: 22px;
      font-weight: 700;
    }

    /* ===== TABEL ===== */
    .table-container {
      width: 95%;
      margin: 20px auto;
      height: calc(100vh - 140px); /* kurangi tinggi header */
      overflow-y: auto;
      overflow-x: auto;
    }

    table {
      width: 100%;
      min-width: 900px;
      border-collapse: collapse;
      text-align: center;
      background-color: #fff;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    th, td {
      padding: 10px;
      border: 1px solid #ddd;
    }

    th {
      background-color: #c9d3ff;
      color: #000;
      font-weight: bold;
      position: sticky;
      top: 0; 
      z-index: 10;
    }

    tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    tr:hover {
      background-color: #b8c3ff;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        width: 100%;
        flex-direction: row;
        justify-content: space-around;
        border-radius: 0;
        padding: 10px;
        height: auto;
        position: relative;
      }

      .sidebar .greeting {
        display: none;
      }

      .sidebar a {
        font-size: 14px;
        padding: 6px 8px;
        margin: 5px;
      }

      table {
        font-size: 12px;
      }

      .header h1 {
        font-size: 22px;
      }

      .header h2 {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="greeting">Hi, Admin Sewing</div>
    <a href="/">Halaman Utama</a>
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/mesin">Mesin</a>
    <a href="/admin/riwayat" class="active">Riwayat</a>
    <a href="/logout" class="logout">Logout</a>
  </div>

  <!-- MAIN CONTENT -->
  <div class="main">
    <!-- HEADER STICKY -->
    <div class="header">
      <h1>DASHBOARD ADMIN</h1>
      <h1>SEWING MACHINE ACTIVITY</h1>
      <h2>Data Riwayat Perpindahan Mesin</h2>
    </div>

    <!-- TABEL -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>ID Mesin</th>
            <th>Merk Mesin</th>
            <th>Nomor Seri</th>
            <th>Kode Barcode</th>
            <th>Line Dari</th>
            <th>Line Ke</th>
            <th>Status Pindah</th>
            <th>Keterangan</th>
            <th>Waktu Pindah</th>
          </tr>
        </thead>
        <tbody>
          <% if (riwayat && riwayat.length > 0) { %>
            <% riwayat.forEach(row => { %>
              <tr>
                <td><%= row.id_mesin %></td>
                <td><%= row.merk_mesin %></td>
                <td><%= row.nomer_seri_mesin %></td>
                <td><%= row.kode_barcode || '-' %></td>
                <td><%= row.line_dari %></td>
                <td><%= row.line_ke %></td>
                <td><%= row.status_pindah %></td>
                <td><%= row.keterangan || '-' %></td>
                <td><%= new Date(row.waktu_pindah).toLocaleString() %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="9">Belum ada data riwayat perpindahan mesin.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
